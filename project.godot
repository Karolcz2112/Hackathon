; Kosmiczny kurier — projekt Godot 4
config_version=5

[application]
config/name="Kosmiczny kurier"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=900
window/size/viewport_height=600
window/size/window_width_override=1000
window/size/window_height_override=667
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.11, 1)
